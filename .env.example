# ============================================================
# WatermarkZero 配置模板
# 复制为 .env 后按你的实际情况填写（本地可用 python-dotenv 或直接 export）
# 最关键的两个开关：EDIT_PROVIDER / DETECT_PROVIDER
# ============================================================

# ---------- 引擎选择 ----------
# 图像擦除引擎：mock | opencv | dashscope | openai
#   opencv = 本地免费修复，无需 Key，开箱即用（对简单背景效果好）
#   mock   = 原样返回，仅测试流程
EDIT_PROVIDER=opencv
# 视觉定位引擎：mock | dashscope | openai | none
#   none = 完全用前端本地像素检测，不调 AI 定位（省钱/省事，推荐先用这个）
DETECT_PROVIDER=mock

# ---------- 阿里云百炼（EDIT_PROVIDER=dashscope 时必填）----------
# 申请地址：https://bailian.console.aliyun.com/  -> API-Key 管理
DASHSCOPE_API_KEY=
# 三个档位对应前端下拉框的 默认/极速/高清；填你账号里真实可用的模型名
DASHSCOPE_MODEL_DEFAULT=wanx2.1-imageedit
DASHSCOPE_MODEL_FAST=wanx2.1-imageedit
DASHSCOPE_MODEL_HQ=wanx2.1-imageedit
# 视觉定位模型（DETECT_PROVIDER=dashscope 时用到）
DASHSCOPE_VL_MODEL=qwen-vl-max-latest

# ---------- OpenAI / OpenAI 兼容中转（EDIT_PROVIDER=openai 时必填）----------
# 注意：中转必须支持 /images/edits 端点才能擦除；只有 chat/completions 的不行
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EDIT_MODEL=gpt-image-1
OPENAI_VL_MODEL=gpt-4o-mini
# 前端下拉框的历史模型名 -> 你反代里真实模型的映射（JSON），定位时用
# 例：{"qwen3.8-flash":"workbuddy/glm-5.3-flash","kimi-k3":"workbuddy/kimi-k3-1"}
OPENAI_VL_MODEL_MAP={"qwen3.8-flash":"workbuddy/glm-5.3-flash","qwen3.8-max":"workbuddy/glm-5.3","kimi-k3":"workbuddy/kimi-k3-1"}
# 视觉定位 max_tokens；强制推理模型要调大，否则正文为空
DETECT_MAX_TOKENS=2000

# ---------- 服务参数（一般不用改）----------
PORT=8000
HTTP_TIMEOUT=180
POLL_MAX_WAIT=300
